{
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel.ts"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/query", "destination": { "service": "backend" } },
    { "source": "/upload", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
